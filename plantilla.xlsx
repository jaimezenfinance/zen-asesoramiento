<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zen — Asesoramiento Financiero</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800;900&family=DM+Sans:wght@300;400;500&family=DM+Mono&display=swap" rel="stylesheet">
<style>
:root {
  --ink: #0f1923;
  --blue: #1a3cff;
  --blue-dim: #e8ecff;
  --salmon: #ff8876;
  --salmon-dim: #fff0ee;
  --green: #00b87a;
  --green-dim: #e0fff5;
  --wa: #25D366;
  --border: #e4e8f0;
  --bg: #f6f7fb;
  --card: #ffffff;
  --muted: #6b7a99;
  --faint: #b0bcd4;
  --red: #e53e3e;
  --red-dim: #fff5f5;
  --zen-navy: #1a2e6b;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--ink); min-height: 100vh; }

.header {
  background: linear-gradient(135deg, var(--zen-navy) 0%, #2a4ba0 100%);
  color: white; padding: 14px 20px;
  display: flex; align-items: center; gap: 14px;
  position: sticky; top: 0; z-index: 100;
  box-shadow: 0 2px 12px rgba(26,46,107,0.3);
}
.header-logo { width: 46px; height: 46px; border-radius: 50%; overflow: hidden; flex-shrink: 0; border: 2px solid rgba(255,255,255,0.35); }
.header-logo img { width: 100%; height: 100%; object-fit: cover; }
.header-center { flex: 1; text-align: center; }
.header-title { font-family: 'Nunito', sans-serif; font-size: 19px; font-weight: 900; letter-spacing: 2px; line-height: 1.1; text-transform: uppercase; color: white; }
.header-date { font-size: 15px; color: rgba(255,255,255,0.9); font-family: 'Nunito', sans-serif; font-weight: 700; text-align: right; min-width: 80px; }

.page { max-width: 680px; margin: 0 auto; padding: 18px 14px 80px; }
.card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 18px; margin-bottom: 14px; }
.card-header { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
.card-icon { font-size: 20px; }
.card-title { font-family: 'Nunito', sans-serif; font-size: 15px; font-weight: 700; }

.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
.grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 10px; }
.field { margin-bottom: 10px; }
.field:last-child { margin-bottom: 0; }
label { font-size: 11px; font-weight: 500; color: var(--muted); display: block; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.4px; }
input[type=text], input[type=number], select, textarea {
  width: 100%; padding: 9px 11px; border: 1.5px solid var(--border); border-radius: 10px;
  font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--ink);
  background: white; outline: none; transition: border-color 0.15s, box-shadow 0.15s;
  -webkit-appearance: none; appearance: none;
}
input:focus, select:focus, textarea:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(26,60,255,0.08); }
textarea { resize: vertical; min-height: 52px; }
hr { border: none; border-top: 1px solid var(--border); margin: 14px 0; }

.mode-toggle { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
.mode-btn { padding: 16px 12px; border-radius: 14px; border: 1.5px solid var(--border); cursor: pointer; font-family: 'DM Sans', sans-serif; background: white; color: var(--muted); transition: all 0.15s; text-align: center; }
.mode-btn .mode-icon { font-size: 28px; display: block; margin-bottom: 6px; }
.mode-btn .mode-label { font-size: 13px; font-weight: 500; }
.mode-btn.active { border-color: var(--blue); background: var(--blue-dim); color: var(--blue); }

.pill-group { display: flex; gap: 6px; flex-wrap: wrap; }
.pill { padding: 7px 14px; border-radius: 20px; border: 1.5px solid var(--border); font-size: 13px; cursor: pointer; font-family: 'DM Sans', sans-serif; background: white; color: var(--muted); transition: all 0.15s; }
.pill.active { background: var(--blue); border-color: var(--blue); color: white; font-weight: 500; }

.titular-block { border: 1px solid var(--border); border-radius: 12px; padding: 14px; margin-bottom: 10px; background: #fafbff; }
.titular-label { font-size: 11px; font-weight: 700; color: var(--blue); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; }

.ing-grid { display: grid; grid-template-columns: 1fr 70px 1fr; gap: 8px; margin-bottom: 6px; }
.total-highlight { background: var(--green-dim); border-radius: 10px; padding: 10px 14px; font-size: 13px; color: var(--green); font-weight: 600; font-family: 'DM Mono'; margin: 8px 0; display: none; }
.total-deudas-highlight { background: var(--red-dim); border-radius: 10px; padding: 10px 14px; font-size: 13px; color: var(--red); font-weight: 600; font-family: 'DM Mono'; margin: 8px 0; display: none; }

.banco-row { display: flex; gap: 8px; align-items: center; margin-bottom: 6px; }
.banco-row select { flex: 1; }
.btn-icon { background: none; border: 1.5px solid var(--border); border-radius: 8px; width: 34px; height: 34px; cursor: pointer; font-size: 18px; color: var(--muted); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.15s; }
.btn-icon:hover { border-color: var(--red); color: var(--red); }

.deuda-item { border: 1px solid var(--border); border-radius: 12px; padding: 12px; margin-bottom: 10px; background: #fafafa; position: relative; }
.deuda-remove { position: absolute; top: 10px; right: 10px; background: none; border: none; color: var(--faint); cursor: pointer; font-size: 20px; line-height: 1; }
.deuda-remove:hover { color: var(--red); }
.btn-add { display: flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 8px; border: 1.5px dashed var(--border); background: none; cursor: pointer; font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--muted); transition: all 0.15s; }
.btn-add:hover { border-color: var(--blue); color: var(--blue); }

.llega-group { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
.llega-btn { padding: 16px; border-radius: 12px; border: 1.5px solid var(--border); font-size: 15px; cursor: pointer; font-family: 'DM Sans', sans-serif; background: white; color: var(--muted); transition: all 0.15s; text-align: center; font-weight: 500; }
.llega-btn .llega-icon { font-size: 24px; display: block; margin-bottom: 4px; }
.llega-btn.si { border-color: var(--green); background: var(--green-dim); color: var(--green); }
.llega-btn.no { border-color: var(--red); background: var(--red-dim); color: var(--red); }

.ideal-form { background: var(--blue-dim); border-radius: 12px; padding: 14px; margin-bottom: 12px; }
.ideal-form.max { background: var(--salmon-dim); }

.nota-mini { margin-top: 12px; }

.btn-primary { width: 100%; padding: 13px; background: var(--blue); color: white; border: none; border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 600; cursor: pointer; transition: opacity 0.15s; }
.btn-primary:hover { opacity: 0.88; }
.btn-wa { width: 100%; padding: 12px; background: var(--wa); color: white; border: none; border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; cursor: pointer; margin-top: 10px; }
.btn-copy { width: 100%; padding: 11px; background: var(--blue-dim); color: var(--blue); border: none; border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; cursor: pointer; margin-top: 10px; }
.btn-sheets { width: 100%; padding: 11px; background: var(--green-dim); color: var(--green); border: none; border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; cursor: pointer; margin-top: 10px; }
.btn-pdf { width: 100%; padding: 11px; background: var(--salmon-dim); color: var(--salmon); border: none; border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; cursor: pointer; margin-top: 10px; }

.output-box { background: #f8fafc; border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; font-family: 'DM Mono'; font-size: 12.5px; line-height: 1.8; white-space: pre-wrap; color: var(--ink); user-select: all; }
.status-msg { font-size: 12px; color: var(--muted); margin-top: 6px; min-height: 18px; }
.status-msg.ok { color: var(--green); }
.status-msg.err { color: var(--red); }
.hidden { display: none !important; }

/* PRINT OVERLAY */
.print-overlay { display:none; position:fixed; inset:0; background:white; z-index:9999; overflow-y:auto; }
.print-overlay.visible { display:block; }
.print-toolbar { background:#1a2e6b; padding:12px 20px; display:flex; gap:10px; align-items:center; }
.print-toolbar button { padding:9px 20px; border:none; border-radius:8px; cursor:pointer; font-family:'Nunito',sans-serif; font-size:14px; font-weight:700; }
.btn-do-print { background:#ff8876; color:white; }
.btn-close-print { background:rgba(255,255,255,0.15); color:white; }
.print-page {
  width:297mm; height:210mm; margin:16px auto; background:white;
  box-shadow:0 4px 24px rgba(0,0,0,0.15); font-family:'DM Sans',sans-serif;
  display:flex; flex-direction:column; overflow:hidden;
}
@media print {
  body { margin:0; padding:0; }
  @page { size:A4 landscape; margin:0; }
}
/* HEADER */
.ph { background:linear-gradient(135deg,#1a2e6b,#2a4ba0); color:white; padding:7px 18px; display:flex; align-items:center; gap:10px; flex-shrink:0; }
.ph-logo { width:32px;height:32px;border-radius:50%;overflow:hidden;border:2px solid rgba(255,255,255,0.3);flex-shrink:0; }
.ph-logo img { width:100%;height:100%;object-fit:cover; }
.ph-title { flex:1;text-align:center;font-family:'Nunito',sans-serif;font-size:17px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase; }
.ph-date { font-family:'Nunito',sans-serif;font-weight:700;font-size:13px;color:rgba(255,255,255,0.9);min-width:70px;text-align:right; }
/* BODY */
.pb { padding:7px 14px 6px; flex:1; display:flex; flex-direction:column; }
/* TOP BAR */
.pt-topbar { display:flex;justify-content:space-between;align-items:center;margin-bottom:7px;padding-bottom:6px;border-bottom:2px solid #1a2e6b; }
.pt-name { font-family:'Nunito',sans-serif;font-size:17px;font-weight:800;color:#1a2e6b; }
.pt-tel { font-size:11px;color:#6b7a99;margin-top:1px; }
.pt-badges { text-align:right; }
.pt-badge { display:inline-block;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.4px; }
.pt-badge.area { background:#e8ecff;color:#1a3cff; }
.pt-badge.mode { margin-left:6px; }
.pt-badge.presup { background:#e8f5e9;color:#2e7d32; }
.pt-badge.pos { background:#e0fff5;color:#00b87a; }
.pt-badge.neg { background:#fff3e0;color:#e65100; }
.pt-agent { font-size:10px;color:#6b7a99;margin-top:2px; }
/* 3-COLUMN MAIN GRID */
.pt-cols { display:grid;grid-template-columns:1fr 1fr;gap:8px;flex:1; }
.pt-section { border:1px solid #e4e8f0;border-radius:6px;overflow:hidden;margin-bottom:5px; }
.pt-section:last-child { margin-bottom:0; }
.pt-sec-head { background:#1a2e6b;color:white;padding:4px 8px;font-family:'Nunito',sans-serif;font-size:10px;font-weight:800;letter-spacing:0.8px;text-transform:uppercase; }
.pt-sec-body { padding:4px 8px; }
.pt-row { display:flex;justify-content:space-between;align-items:baseline;padding:2px 0;border-bottom:1px solid #f0f2f8;font-size:11px; }
.pt-row:last-child { border-bottom:none; }
.pt-rl { color:#6b7a99;font-weight:500; }
.pt-rv { font-weight:600;color:#0f1923;text-align:right;max-width:55%; }
/* TITULAR CARDS */
.tit-card { border:1px solid #e4e8f0;border-radius:5px;padding:4px 7px;margin-bottom:4px; }
.tit-card:last-child { margin-bottom:0; }
.tit-tag { font-size:9px;font-weight:800;color:#1a3cff;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:3px; }
.tit-r { font-size:11px;color:#0f1923;margin-bottom:1px; }
.tit-r span { color:#6b7a99;margin-right:4px; }
/* RESULTADO */
.res-box { border-radius:7px;padding:8px 10px;margin-bottom:6px; }
.res-box:last-child { margin-bottom:0; }
.res-box.ideal { background:#e8ecff;border:1px solid #c5d0ff; }
.res-box.ideal.llega { background:#e0fff5;border:1px solid #a0e8cc; }
.res-box.max { background:#fff0ee;border:1px solid #ffd0c5; }
.res-lbl { font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:3px; }
.res-lbl.ideal { color:#1a3cff; }
.res-lbl.llega { color:#00b87a; }
.res-lbl.max { color:#ff8876; }
.res-val { font-family:'Nunito',sans-serif;font-size:26px;font-weight:900;color:#1a2e6b;line-height:1; }
.res-sub { font-size:10px;color:#6b7a99;margin-top:2px;line-height:1.2; }
/* NOTAS */
.nota-r { font-size:11px;color:#0f1923;padding:2px 0;border-bottom:1px solid #f0f2f8; }
.nota-r:last-child { border-bottom:none; }
/* FOOTER */
.pt-footer { background:#f4f6fb;border-top:1px solid #e4e8f0;padding:4px 14px;display:flex;justify-content:space-between;font-size:10px;color:#6b7a99;flex-shrink:0; }
.pt-footer strong { color:#1a2e6b; }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"><\/script>
</head>
<body>

<div class="header">
  <div class="header-logo"><img src="data:image/png;base64," alt="Zen"></div>
  <div class="header-center">
    <div class="header-title">ASESORAMIENTO FINANCIERO</div>
  </div>
  <div class="header-date" id="headerDate"></div>
</div>

<div class="page">

<!-- 1. IDENTIFICACIÓN -->
<div class="card">
  <div class="card-header"><span class="card-icon">👤</span><span class="card-title">Identificación</span></div>
  <div class="grid2">
    <div class="field"><label>Nombre</label><input type="text" id="nombre" placeholder="Nombre completo"></div>
    <div class="field"><label>Teléfono</label><input type="text" id="telefono" placeholder="600 000 000"></div>
  </div>
  <div class="grid3">
    <div class="field"><label>Área / Oficina</label>
      <select id="area" onchange="setAgente()">
        <option value="">— Área —</option>
        <option value="Algeciras">Algeciras</option>
        <option value="La Línea">La Línea</option>
        <option value="San Roque">San Roque</option>
      </select>
    </div>
    <div class="field"><label>Asesor</label>
      <select id="asesor">
        <option value="">— Asesor —</option>
        <option value="Alicia">Alicia</option>
        <option value="Jaime">Jaime</option>
        <option value="Keyla">Keyla</option>
        <option value="María">María</option>
        <option value="Miguel">Miguel</option>
        <option value="Safaa">Safaa</option>
      </select>
    </div>
    <div class="field"><label>Canal</label>
      <select id="canal">
        <option value="telefónico">Telefónico</option>
        <option value="presencial">Presencial</option>
      </select>
    </div>
  </div>
</div>

<!-- 2. TIPO ASESORAMIENTO -->
<div class="card">
  <div class="card-header"><span class="card-icon">🎯</span><span class="card-title">Tipo de asesoramiento</span></div>
  <div class="mode-toggle">
    <button class="mode-btn active" id="modePresupuesto" onclick="setMode('presupuesto')">
      <span class="mode-icon">💰</span><span class="mode-label">Establecer presupuesto</span>
    </button>
    <button class="mode-btn" id="modePrecio" onclick="setMode('precio')">
      <span class="mode-icon">🏠</span><span class="mode-label">Precio de propiedad</span>
    </button>
  </div>
  <div id="secPrecioVivienda" class="hidden">
    <div class="field"><label>Precio de la propiedad (k)</label>
      <input type="number" id="precioVivienda" placeholder="125">
    </div>
  </div>
</div>

<!-- 3. TITULARES -->
<div class="card">
  <div class="card-header"><span class="card-icon">👥</span><span class="card-title">Titulares</span></div>
  <div class="field">
    <label>Compra</label>
    <div class="pill-group">
      <button class="pill active" id="pillSolo" onclick="setTitulares(1)">Solo/a</button>
      <button class="pill" id="pillPareja" onclick="setTitulares(2)">Con pareja</button>
    </div>
  </div>
  <hr>

  <!-- Titular 1 -->
  <div class="titular-block">
    <div class="titular-label" id="t1label">Titular</div>
    <div class="grid3">
      <div class="field"><label>Sexo</label>
        <select id="sexo1" onchange="updateEcivil(1)">
          <option value="m">👨 Hombre</option>
          <option value="f">👩 Mujer</option>
        </select>
      </div>
      <div class="field"><label>Edad</label><input type="number" id="edad1" placeholder="30"></div>
    </div>
    <div class="grid2">
      <div class="field"><label>Estado civil</label>
        <select id="ecivil1">
          <option value="">—</option>
          <option value="Soltero">Soltero</option>
          <option value="Casado">Casado</option>
          <option value="Divorciado">Divorciado</option>
          <option value="Viudo">Viudo</option>
        </select>
      </div>
      <div class="field"><label>Hijos</label>
        <select id="hijos1">
          <option value="0">Sin hijos</option>
          <option value="1">1 hijo</option>
          <option value="2">2 hijos</option>
          <option value="3">3+ hijos</option>
        </select>
      </div>
    </div>
    <div class="grid3">
      <div class="field"><label>Contrato</label>
        <select id="contrato1">
          <option value="">—</option>
          <option value="Fijo">Fijo</option>
          <option value="Discontinuo">Discontinuo</option>
          <option value="Autónomo">Autónomo</option>
          <option value="Funcionario">Funcionario</option>
          <option value="Otro">Otro</option>
        </select>
      </div>
      <div class="field"><label>Antigüedad</label>
        <div style="display:flex;gap:4px">
          <input type="number" id="antig1" placeholder="2" style="width:55px;flex-shrink:0">
          <select id="antigUnit1"><option value="años">años</option><option value="meses">meses</option></select>
        </div>
      </div>
      <div class="field"><label>País</label>
        <select id="pais1">
          <option value="">España</option>
          <option value="Gib">Gibraltar</option>
        </select>
      </div>
    </div>
    <div class="field"><label>Ingresos (€)</label>
      <div class="ing-grid">
        <div><label style="font-size:10px">Ingresos (€)</label><input type="number" id="ing1" placeholder="1500" oninput="calcIng()"></div>
        <div><label style="font-size:10px">Pagas</label><select id="pagas1" onchange="calcIng()"><option value="12">×12</option><option value="14">×14</option></select></div>
        <div><label style="font-size:10px">Neto/mes</label><input type="number" id="ingNeto1" readonly style="background:#f5f5f5;color:var(--muted)"></div>
      </div>
    </div>
    <div class="field"><label>Banco(s)</label>
      <div id="bancosList1"></div>
      <button class="btn-add" onclick="addBanco(1)" style="margin-top:4px">＋ Banco</button>
    </div>
  </div>

  <!-- Titular 2 -->
  <div class="titular-block hidden" id="titular2block">
    <div class="titular-label">Titular 2</div>
    <div class="grid3">
      <div class="field"><label>Sexo</label>
        <select id="sexo2" onchange="updateEcivil(2)">
          <option value="m">👨 Hombre</option>
          <option value="f">👩 Mujer</option>
        </select>
      </div>
      <div class="field"><label>Edad</label><input type="number" id="edad2" placeholder="30"></div>
    </div>
    <div class="grid2">
      <div class="field"><label>Estado civil</label>
        <select id="ecivil2">
          <option value="">—</option>
          <option value="Soltero">Soltero</option>
          <option value="Casado">Casado</option>
          <option value="Divorciado">Divorciado</option>
          <option value="Viudo">Viudo</option>
        </select>
      </div>
      <div class="field"><label>Hijos</label>
        <select id="hijos2">
          <option value="0">Sin hijos</option>
          <option value="1">1 hijo</option>
          <option value="2">2 hijos</option>
          <option value="3">3+ hijos</option>
        </select>
      </div>
    </div>
    <div class="grid3">
      <div class="field"><label>Contrato</label>
        <select id="contrato2">
          <option value="">—</option>
          <option value="Fijo">Fijo</option>
          <option value="Discontinuo">Discontinuo</option>
          <option value="Autónomo">Autónomo</option>
          <option value="Funcionario">Funcionario</option>
          <option value="Otro">Otro</option>
        </select>
      </div>
      <div class="field"><label>Antigüedad</label>
        <div style="display:flex;gap:4px">
          <input type="number" id="antig2" placeholder="2" style="width:55px;flex-shrink:0">
          <select id="antigUnit2"><option value="años">años</option><option value="meses">meses</option></select>
        </div>
      </div>
      <div class="field"><label>País</label>
        <select id="pais2">
          <option value="">España</option>
          <option value="Gib">Gibraltar</option>
        </select>
      </div>
    </div>
    <div class="field"><label>Ingresos (€)</label>
      <div class="ing-grid">
        <div><label style="font-size:10px">Ingresos (€)</label><input type="number" id="ing2" placeholder="1200" oninput="calcIng()"></div>
        <div><label style="font-size:10px">Pagas</label><select id="pagas2" onchange="calcIng()"><option value="12">×12</option><option value="14">×14</option></select></div>
        <div><label style="font-size:10px">Neto/mes</label><input type="number" id="ingNeto2" readonly style="background:#f5f5f5;color:var(--muted)"></div>
      </div>
    </div>
    <div class="field"><label>Banco(s)</label>
      <div id="bancosList2"></div>
      <button class="btn-add" onclick="addBanco(2)" style="margin-top:4px">＋ Banco</button>
    </div>
  </div>

  <div class="total-highlight" id="totalIngBox">💚 Total ingresos combinados: <span id="totalIngVal">—</span> €/mes</div>

  <div class="nota-mini">
    <label>Nota titulares</label>
    <textarea id="notaTitulares" placeholder="Observaciones sobre los titulares..."></textarea>
  </div>
</div>

<!-- 4. FINANZAS -->
<div class="card">
  <div class="card-header"><span class="card-icon">💶</span><span class="card-title">Finanzas</span></div>
  <div id="deudasList"></div>
  <button class="btn-add" onclick="addDeuda()">＋ Añadir deuda</button>
  <div class="total-deudas-highlight" id="totalDeudasBox">🔴 Total deudas: <span id="totalDeudasVal">—</span> €/mes</div>
  <hr>
  <div class="grid2">
    <div class="field"><label>Entrada / Ahorros (k)</label><input type="number" id="entrada" placeholder="5"></div>
    <div class="field"><label>Presupuesto mes (€)</label><input type="number" id="presuMes" placeholder="700"></div>
  </div>
  <div class="grid3">
    <div class="field"><label>Ratio mensual (€)</label><input type="number" id="ratioMensual" placeholder="575"></div>
    <div class="field"><label>Máx. financiación (k)</label><input type="number" id="ratioMaxK" placeholder="207"></div>
    <div class="field"><label>Plazo (años)</label><input type="number" id="ratioAnos" placeholder="30"></div>
  </div>
  <div class="nota-mini">
    <label>Nota finanzas</label>
    <textarea id="notaFinanzas" placeholder="Observaciones sobre finanzas..."></textarea>
  </div>
</div>

<!-- 5. RESULTADO -->
<div class="card">
  <div class="card-header"><span class="card-icon">🏆</span><span class="card-title">Resultado</span></div>

  <!-- LLEGA / NO LLEGA — solo en modo precio propiedad -->
  <div id="secLlegaBtns" class="hidden">
    <div class="llega-group" style="margin-bottom:14px">
      <button class="llega-btn" id="btnLlegaSi" onclick="setLlega('si')">
        <span class="llega-icon">✅</span>Llega
      </button>
      <button class="llega-btn" id="btnLlegaNo" onclick="setLlega('no')">
        <span class="llega-icon">❌</span>No llega
      </button>
    </div>
  </div>

  <!-- PRECIO IDEAL — siempre visible -->
  <div class="ideal-form">
    <label id="idealFormLabel" style="color:var(--blue);font-size:12px;font-weight:700;display:block;margin-bottom:10px">👌 PRECIO IDEAL</label>
    <div class="grid3">
      <div class="field"><label id="idealKLabel">Precio ideal (k)</label><input type="number" id="idealK" placeholder="150"></div>
      <div class="field"><label>Hipoteca %</label><input type="number" id="idealHip" placeholder="90" min="0" max="100"></div>
      <div class="field"><label>Aportación (k)</label><input type="number" id="idealAport" placeholder="22"></div>
    </div>
    <p id="idealFormSub" style="font-size:11px;color:var(--blue);margin-top:-4px">Presupuesto mes tomado de Finanzas</p>
  </div>

  <!-- MAX COMPRA — siempre visible -->
  <div class="ideal-form max">
    <label style="color:var(--salmon);font-size:12px;font-weight:700;display:block;margin-bottom:10px">💸 MAX COMPRA</label>
    <div class="grid3">
      <div class="field"><label>Max compra (k)</label><input type="number" id="maxK" placeholder="185"></div>
      <div class="field"><label>Hipoteca %</label><input type="number" id="maxHip" placeholder="90" min="0" max="100"></div>
      <div class="field"><label>Aportación (k)</label><input type="number" id="maxAport" placeholder="33"></div>
    </div>
  </div>

  <div class="nota-mini" style="margin-top:4px">
    <label>Nota resultado</label>
    <textarea id="notaResultado" placeholder="Observaciones sobre el resultado..."></textarea>
  </div>
</div>


<!-- EXCEL BUTTON CARD -->
<div class="card">
  <div class="card-header"><span class="card-icon">📊</span><span class="card-title">Hacer números</span></div>
  <button class="btn-primary" id="btnExcel" onclick="abrirExcel()" style="background:var(--green);">📊 Abrir en Excel</button>
  <p style="font-size:11px;color:var(--muted);margin-top:8px;">Popula la plantilla con los datos del asesoramiento y la descarga</p>
</div>

<!-- 6. GENERAR -->
<div class="card">
  <div class="card-header"><span class="card-icon">📤</span><span class="card-title">Generar y compartir</span></div>
  <button class="btn-primary" onclick="generar()">Generar resumen</button>
  <div id="outputSection" class="hidden">
    <hr style="margin-top:16px">
    <label style="display:block;margin-bottom:8px;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.4px">Mensaje WhatsApp</label>
    <div class="output-box" id="outputBox"></div>
    <button class="btn-copy" onclick="copiar()" id="btnCopiar">Copiar texto</button>
    
    <button class="btn-sheets" onclick="guardarSheets()" id="btnSheets">📊 Guardar en Google Sheets</button>
    <button class="btn-pdf" onclick="abrirImprimir()">🖨️ Vista para imprimir</button>
    <div class="status-msg" id="statusMsg"></div>
  </div>
</div>


<!-- PRINT OVERLAY -->
<div class="print-overlay" id="printOverlay">
  <div class="print-toolbar">
    <button class="btn-do-print" onclick="imprimirVentana()">🖨️ Imprimir / Guardar PDF</button>
    <button class="btn-close-print" onclick="closePrint()">✕ Cerrar</button>
  </div>
  <div class="print-page" id="printPage">
    <div class="ph">
      <div class="ph-logo"><img src="data:image/png;base64," alt="Zen"></div>
      <div class="ph-title">Asesoramiento Financiero</div>
      <div class="ph-date" id="pp_fecha"></div>
    </div>
    <div class="pb">
      <div class="pt-topbar">
        <div>
          <div class="pt-name" id="pp_nombre"></div>
          <div class="pt-tel" id="pp_tel"></div>
        </div>
        <div class="pt-badges">
          <span class="pt-badge area" id="pp_area"></span>
          <span class="pt-badge mode" id="pp_modeBadge"></span>
          <div class="pt-agent">Asesor: <strong id="pp_agente"></strong></div>
        </div>
      </div>
      <div class="pt-cols">
        <!-- COL 1: TITULARES -->
        <div>
          <div class="pt-section">
            <div class="pt-sec-head">👥 Titulares</div>
            <div class="pt-sec-body" id="pp_titulares"></div>
          </div>
        </div>
        <!-- COL 2: FINANZAS -->
        <div>
          <div class="pt-section">
            <div class="pt-sec-head">💶 Finanzas</div>
            <div class="pt-sec-body">
              <div class="pt-row"><span class="pt-rl">Ingresos</span><span class="pt-rv" id="pp_ing"></span></div>
              <div class="pt-row"><span class="pt-rl">Deudas</span><span class="pt-rv" id="pp_deu"></span></div>
              <div class="pt-row"><span class="pt-rl">Entrada / Ahorros</span><span class="pt-rv" id="pp_ent"></span></div>
              <div class="pt-row"><span class="pt-rl">Presupuesto mes</span><span class="pt-rv" id="pp_presu"></span></div>
              <div class="pt-row"><span class="pt-rl">Ratio</span><span class="pt-rv" id="pp_rat"></span></div>
            </div>
          </div>
        </div>
        <!-- COL 3: RESULTADO + NOTAS -->
        <div>
          <div class="res-box ideal" id="pp_idealBox" style="margin-bottom:14px">
            <div class="res-lbl ideal" id="pp_idealLbl">👌 PRECIO IDEAL</div>
            <div class="res-val" id="pp_idealK">—</div>
            <div class="res-sub" id="pp_idealSub"></div>
          </div>
          <div class="res-box max" style="margin-bottom:14px">
            <div class="res-lbl max">💸 MAX COMPRA</div>
            <div class="res-val" id="pp_maxK">—</div>
            <div class="res-sub" id="pp_maxSub"></div>
          </div>
          <div class="pt-section">
            <div class="pt-sec-head">💡 Notas</div>
            <div class="pt-sec-body" id="pp_notas"><div class="nota-r" style="color:#b0bcd4;font-style:italic">Sin notas</div></div>
          </div>
        </div>
      </div>
    </div>
    <div class="pt-footer">
      <div>ZenFinances.es · <strong id="pp_footerArea"></strong></div>
      <div>614 45 45 67 · info@zenfinance.es</div>
    </div>
  </div>
</div>

</div>

<script>
const SHEET_URL = "https://script.google.com/macros/s/AKfycbzwmMjLC6sx4c71v15xXJQ7ee4QTO3QLCputn-t2KqH27ThLM5Z-czjPstplh--33cq/exec";
const AGENTES_FIJOS = { 'La Línea': 'Safaa', 'San Roque': 'Keyla' };

const ECIVIL_M = { 'Soltero': 'Soltero', 'Casado': 'Casado', 'Divorciado': 'Divorciado', 'Viudo': 'Viudo' };
const ECIVIL_F = { 'Soltero': 'Soltera', 'Casado': 'Casada', 'Divorciado': 'Divorciada', 'Viudo': 'Viuda' };

function updateEcivil(n) {
  const sexo = document.getElementById('sexo'+n).value;
  const sel = document.getElementById('ecivil'+n);
  const current = sel.value;
  const isFem = sexo === 'f';
  sel.innerHTML = '<option value="">—</option>'
    + ['Soltero','Casado','Divorciado','Viudo'].map(k => {
        const label = isFem ? ECIVIL_F[k] : ECIVIL_M[k];
        return '<option value="'+k+'"'+(current===k?' selected':'')+'>'+label+'</option>';
      }).join('');
}
const BANCOS_LIST = ['BBVA Online','BBVA Sucursal','Caja Granada','Caja Rural','Cajamar','Cajasur','CaixaBank','ING','Sabadell','Santander','UCI','Unicaja','Otro'];

let mode = 'presupuesto';
let numTitulares = 1;
let llega = null;
let deudaCount = 0;
let bancoCount = {1:0, 2:0};
let lastMsg = '';

const now = new Date();
const MONTHS_EN = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const MONTHS_ES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const mesActual = MONTHS_ES[now.getMonth()];
document.getElementById('headerDate').textContent = now.getDate() + ' ' + MONTHS_ES[now.getMonth()];

function setAgente() {
  const area = document.getElementById('area').value;
  const fijo = AGENTES_FIJOS[area];
  if (fijo) document.getElementById('asesor').value = fijo;
}

function setMode(m) {
  mode = m;
  document.getElementById('modePresupuesto').classList.toggle('active', m==='presupuesto');
  document.getElementById('modePrecio').classList.toggle('active', m==='precio');
  document.getElementById('secPrecioVivienda').classList.toggle('hidden', m!=='precio');
  document.getElementById('secLlegaBtns').classList.toggle('hidden', m!=='precio');
  if(m==='presupuesto') {
    document.getElementById('idealFormLabel').textContent = '👌 PRECIO IDEAL';
    document.getElementById('idealKLabel').textContent = 'Precio ideal (k)';
    document.getElementById('idealFormSub').style.display = 'block';
    llega = null;
    document.getElementById('btnLlegaSi').className = 'llega-btn';
    document.getElementById('btnLlegaNo').className = 'llega-btn';
  }
}

function setTitulares(n) {
  numTitulares = n;
  document.getElementById('pillSolo').classList.toggle('active', n===1);
  document.getElementById('pillPareja').classList.toggle('active', n===2);
  document.getElementById('titular2block').classList.toggle('hidden', n===1);
  document.getElementById('t1label').textContent = n===2 ? 'Titular 1' : 'Titular';
  calcIng();
}

function setLlega(val) {
  llega = val;
  document.getElementById('btnLlegaSi').className = 'llega-btn'+(val==='si'?' si':'');
  document.getElementById('btnLlegaNo').className = 'llega-btn'+(val==='no'?' no':'');
  const lbl = document.getElementById('idealFormLabel');
  const kLbl = document.getElementById('idealKLabel');
  const sub = document.getElementById('idealFormSub');
  if(val==='si') {
    lbl.textContent = '👌 LLEGA BIEN';
    kLbl.textContent = 'Precio (k)';
    sub.style.display = 'none';
    // Auto-populate from precio propiedad
    const pv = document.getElementById('precioVivienda').value;
    if(pv) document.getElementById('idealK').value = pv;
  } else {
    lbl.textContent = '👌 PRECIO IDEAL';
    kLbl.textContent = 'Precio ideal (k)';
    sub.style.display = 'block';
  }
}

function calcIng() {
  const i1=parseFloat(document.getElementById('ing1').value)||0;
  const p1=parseInt(document.getElementById('pagas1').value)||12;
  const n1=Math.round(i1*p1/12);
  document.getElementById('ingNeto1').value = n1>0 ? n1 : '';

  if (numTitulares===2) {
    const i2=parseFloat(document.getElementById('ing2').value)||0;
    const p2=parseInt(document.getElementById('pagas2').value)||12;
    const n2=Math.round(i2*p2/12);
    document.getElementById('ingNeto2').value = n2>0 ? n2 : '';
    const total=n1+n2;
    document.getElementById('totalIngBox').style.display = total>0 ? 'block' : 'none';
    document.getElementById('totalIngVal').textContent = total.toLocaleString('es');
  } else {
    document.getElementById('totalIngBox').style.display = 'none';
  }
}

function addBanco(t) {
  bancoCount[t]++;
  const id=t+'_'+bancoCount[t];
  const div=document.createElement('div');
  div.className='banco-row'; div.id='banco_'+id;
  const opts=BANCOS_LIST.map(b=>'<option value="'+b+'">'+b+'</option>').join('');
  div.innerHTML='<select id="bancoSel_'+id+'">'+opts+'</select><button class="btn-icon" onclick="document.getElementById(\'banco_'+id+'\').remove()">×</button>';
  document.getElementById('bancosList'+t).appendChild(div);
}

function addDeuda() {
  deudaCount++;
  const id=deudaCount;
  const div=document.createElement('div');
  div.className='deuda-item'; div.id='deuda_'+id;
  div.innerHTML='<button class="deuda-remove" onclick="document.getElementById(\'deuda_'+id+'\').remove();updateTotalDeudas()">×</button>'
    +'<div class="grid2" style="margin-bottom:8px">'
    +'<div><label>Tipo</label><select id="deudaTipo_'+id+'"><option>Hipoteca</option><option>Coche</option><option>Moto</option><option>Préstamo</option><option>Otro</option></select></div>'
    +'<div><label>Cuota mensual (€)</label><input type="number" id="deudaCuota_'+id+'" placeholder="200" oninput="updateTotalDeudas()"></div>'
    +'</div><div><label>Nota</label><input type="text" id="deudaNota_'+id+'" placeholder="Ej: 3 años restantes"></div>';
  document.getElementById('deudasList').appendChild(div);
  updateTotalDeudas();
}

function updateTotalDeudas() {
  const items=getDeudas();
  const total=items.reduce((s,d)=>s+d.cuota,0);
  const box=document.getElementById('totalDeudasBox');
  box.style.display = items.length>1 ? 'block' : 'none';
  document.getElementById('totalDeudasVal').textContent = total.toLocaleString('es');
}

function getDeudas() {
  const items=[];
  for (let i=1; i<=deudaCount; i++) {
    const el=document.getElementById('deuda_'+i);
    if (!el) continue;
    items.push({ tipo: document.getElementById('deudaTipo_'+i).value, cuota: parseFloat(document.getElementById('deudaCuota_'+i).value)||0, nota: document.getElementById('deudaNota_'+i).value.trim() });
  }
  return items;
}

function getBancos(t) {
  return Array.from(document.getElementById('bancosList'+t).querySelectorAll('select')).map(s=>s.value).filter(Boolean);
}

function v(id) { return (document.getElementById(id).value||'').trim(); }

function buildTitularLine(n) {
  const edad=v('edad'+n), ec=v('ecivil'+n), hijos=parseInt(v('hijos'+n))||0;
  const cont=v('contrato'+n), ant=v('antig'+n), antU=v('antigUnit'+n), pais=v('pais'+n);
  const sexo=v('sexo'+n);
  const isFem = sexo === 'f';
  const ecLabel = ec ? (isFem ? (ECIVIL_F[ec]||ec) : (ECIVIL_M[ec]||ec)) : '';
  let parts=[];
  let perfil=''; if(ecLabel) perfil+=ecLabel; if(edad) perfil+=(perfil?' ':'')+edad;
  if(hijos>0) perfil+=(perfil?' ':'')+' con '+(hijos===1?'un hijo':hijos===2?'2 hijos':'3+ hijos');
  if(perfil.trim()) parts.push(perfil.trim());
  let contStr=cont||'';
  if(ant) contStr+=(contStr?' ':'')+ant+' '+antU;
  if(pais==='Gib') contStr+=' en Gib';
  if(contStr.trim()) parts.push(contStr.trim());
  return parts.join(', ');
}

function generar() {
  const nombre=v('nombre'), tel=v('telefono'), area=v('area'), asesor=v('asesor'), canal=v('canal');

  const i1=parseFloat(v('ing1'))||0, p1=parseInt(v('pagas1'))||12, n1=Math.round(i1*p1/12);
  const i2=parseFloat(v('ing2'))||0, p2=parseInt(v('pagas2'))||12, n2=numTitulares===2?Math.round(i2*p2/12):0;
  const bancos1=getBancos(1), bancos2=numTitulares===2?getBancos(2):[];

  // Líneas de perfil — una por titular
  const t1line = buildTitularLine(1);
  const t2line = numTitulares===2 ? buildTitularLine(2) : '';

  // Ing line
  let ingLine='';
  if (numTitulares===1) {
    ingLine=n1.toLocaleString('es')+'€ (×'+p1+')';
    if(bancos1.length) ingLine+=', '+bancos1.join('/');
  } else {
    const total=n1+n2;
    ingLine=n1.toLocaleString('es')+'€ (×'+p1+') + '+n2.toLocaleString('es')+'€ (×'+p2+') = '+total.toLocaleString('es')+'€';
    const allB=[...bancos1,...bancos2].filter((b,i,a)=>a.indexOf(b)===i);
    if(allB.length) ingLine+=', '+allB.join('/');
  }

  // Deu line
  const deudas=getDeudas();
  let deuLine='0';
  if(deudas.length===1) {
    const d=deudas[0];
    deuLine=d.tipo+' '+d.cuota.toLocaleString('es')+'€'+(d.nota?' ('+d.nota+')':'');
  } else if(deudas.length>1) {
    const total=deudas.reduce((s,d)=>s+d.cuota,0);
    deuLine=deudas.map(d=>d.cuota.toLocaleString('es')+'€'+(d.nota?' ('+d.nota+')':'')).join(' + ')+' = '+total.toLocaleString('es')+'€';
  }

  const entrada=v('entrada')||'0';
  const presuMes=v('presuMes');
  const rM=v('ratioMensual'), rK=v('ratioMaxK'), rA=v('ratioAnos');
  let ratioLine=''; if(rM) ratioLine+=rM+'€'; if(rK) ratioLine+=' / '+rK+'k'; if(rA) ratioLine+=' a '+rA+' años';

  // Notas — sin línea separadora, sin negritas
  const notaTit=v('notaTitulares'), notaFin=v('notaFinanzas'), notaRes=v('notaResultado');

  const Z='\u200B';

  // Header según modo
  let headerLine='';
  if(mode==='presupuesto') {
    headerLine='🎯 *Asesoramiento*';
  } else {
    const p=parseFloat(v('precioVivienda'))||0;
    const pK=p; // ya está en k
    headerLine='🎯 *'+pK+'k — '+(llega==='si'?'POSITIVO':llega==='no'?'NEGATIVO':'PENDIENTE')+'*';
  }

  // Precio ideal y max — siempre
  const ik=v('idealK'), ih=v('idealHip'), ia=v('idealAport');
  const mk=v('maxK'), mh=v('maxHip'), ma=v('maxAport');
  const presuUsado=presuMes||'—';

  let resLines='';
  if(mode==='presupuesto') {
    if(ik) resLines+='👌 *Precio Ideal: '+ik+'k* según el presupuesto mensual del cliente de '+presuUsado+'€ con hipoteca '+ih+'% y '+ia+'k aportación.';
  } else {
    if(llega==='si') {
      if(ik) resLines+='👌 *Llega bien a '+ik+'k* con hipoteca '+ih+'% y '+ia+'k aportación.';
    } else {
      if(ik) resLines+='👌 *Precio Ideal: '+ik+'k* según el presupuesto mensual del cliente de '+presuUsado+'€ con hipoteca '+ih+'% y '+ia+'k aportación.';
    }
  }
  if(mk) resLines+=(resLines?'\n'+Z+'\n':'')+'💸 *Max Compra: '+mk+'k* con hipoteca '+mh+'% y '+ma+'k aportación.';

  // Notas — sin separador entre ellas
  let perfilBlock = t1line;
  if(t2line) perfilBlock += '\n' + t2line;

  let notasBlock = '';
  if(notaTit) notasBlock += (notasBlock?'\n':'')+'💡 Nota: '+notaTit;
  if(notaFin) notasBlock += (notasBlock?'\n':'')+'💡 Nota: '+notaFin;
  if(notaRes) notasBlock += (notasBlock?'\n':'')+'💡 Nota: '+notaRes;
  if(!notaTit && !notaFin && !notaRes) notasBlock = '💡 Nota: —';

  lastMsg=nombre+' '+tel+' ('+area+', '+canal+')\n'
    +headerLine+'\n'
    +perfilBlock+'\n'
    +'Ing: '+ingLine+'\n'
    +'Deu: '+deuLine+'\n'
    +'Ent: '+entrada+'k\n'
    +'Rat: '+ratioLine+'\n'
    +Z+'\n'
    +notasBlock+'\n'
    +Z+'\n'
    +resLines+'\n'
    +Z+'\n'
    +'🦸‍♀️ Agente: '+asesor;

  document.getElementById('outputBox').textContent=lastMsg;
  document.getElementById('outputSection').classList.remove('hidden');
  document.getElementById('statusMsg').textContent='';
  document.getElementById('btnSheets').disabled=false;
  document.getElementById('btnSheets').textContent='📊 Guardar en Google Sheets';
  document.getElementById('outputSection').scrollIntoView({behavior:'smooth'});
}

function copiar() {
  navigator.clipboard.writeText(lastMsg).then(()=>{
    const b=document.getElementById('btnCopiar');
    b.textContent='Copiado ✓'; setTimeout(()=>b.textContent='Copiar texto',2000);
  });
}

function abrirWA() { window.open('https://wa.me/?text='+encodeURIComponent(lastMsg),'_blank'); }

async function guardarSheets() {
  const btn=document.getElementById('btnSheets'), st=document.getElementById('statusMsg');
  btn.disabled=true; btn.textContent='Guardando...';
  const fechaStr=now.getDate()+' '+MONTHS_ES[now.getMonth()];
  try {
    await fetch(SHEET_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        nombre:v('nombre')+' '+v('telefono'),
        cuando:fechaStr,
        donde:v('area'),
        como:v('canal'),
        agente:v('asesor'),
        hoja:mesActual
      })
    });
    st.textContent='✓ Guardado en Google Sheets ('+mesActual+')'; st.className='status-msg ok';
    btn.textContent='✓ Guardado';
  } catch(e) {
    st.textContent='Error al guardar.'; st.className='status-msg err';
    btn.disabled=false; btn.textContent='📊 Guardar en Google Sheets';
  }
}

function abrirImprimir() {
  const i1=parseFloat(v('ing1'))||0,p1=parseInt(v('pagas1'))||12,n1=Math.round(i1*p1/12);
  const i2=parseFloat(v('ing2'))||0,p2=parseInt(v('pagas2'))||12,n2=numTitulares===2?Math.round(i2*p2/12):0;
  const bancos1=getBancos(1),bancos2=numTitulares===2?getBancos(2):[];
  const ik=v('idealK'),ih=v('idealHip'),ia=v('idealAport');
  const mk=v('maxK'),mh=v('maxHip'),ma=v('maxAport');
  const presuMes=v('presuMes');

  // Fill header
  document.getElementById('pp_fecha').textContent=now.getDate()+' '+MONTHS_ES[now.getMonth()];
  document.getElementById('pp_nombre').textContent=v('nombre');
  document.getElementById('pp_tel').textContent=v('telefono');
  document.getElementById('pp_area').textContent=v('area');
  document.getElementById('pp_agente').textContent=v('asesor');
  document.getElementById('pp_footerArea').textContent=v('area');
  // canal removed from footer

  // Mode badge
  const mb=document.getElementById('pp_modeBadge');
  if(mode==='presupuesto'){mb.textContent='Presupuesto';mb.className='pt-badge mode presup';}
  else if(llega==='si'){mb.textContent='✅ Positivo';mb.className='pt-badge mode pos';}
  else{mb.textContent='❌ Negativo';mb.className='pt-badge mode neg';}

  // Titulares
  const titEl=document.getElementById('pp_titulares');
  titEl.innerHTML='';
  for(let n=1;n<=numTitulares;n++){
    const ec=v('ecivil'+n),sexo=v('sexo'+n),edad=v('edad'+n);
    const isFem=sexo==='f';
    const ecLabel=ec?(isFem?(ECIVIL_F[ec]||ec):(ECIVIL_M[ec]||ec)):'—';
    const hijos=parseInt(v('hijos'+n))||0;
    const cont=v('contrato'+n),ant=v('antig'+n),antU=v('antigUnit'+n),pais=v('pais'+n);
    const neto=n===1?n1:n2;
    const bancos=n===1?bancos1:bancos2;
    const contStr=[cont,ant?(ant+' '+antU):'',pais==='Gib'?'en Gib':''].filter(Boolean).join(' ');
    const div=document.createElement('div');
    div.className='tit-card';
    div.innerHTML=(numTitulares>1?'<div class="tit-tag">Titular '+n+'</div>':'')
      +'<div class="tit-r"><span>Sexo/Edad:</span>'+(isFem?'👩':'👨')+' '+edad+'</div>'
      +'<div class="tit-r"><span>Civil/Hijos:</span>'+ecLabel+(hijos>0?' · '+(hijos===1?'1 hijo':hijos+' hijos'):'')+'</div>'
      +'<div class="tit-r"><span>Contrato:</span>'+(contStr||'—')+'</div>'
      +'<div class="tit-r"><span>Ingresos:</span>'+(neto>0?neto.toLocaleString('es')+'€/mes':'—')+'</div>'
      +'<div class="tit-r"><span>Banco:</span>'+(bancos.length?bancos.join('/'):'—')+'</div>';
    titEl.appendChild(div);
  }

  // Finanzas
  let ingLine='';
  if(numTitulares===1){ingLine=n1.toLocaleString('es')+'€';if(bancos1.length)ingLine+=', '+bancos1.join('/');}
  else{const tot=n1+n2;ingLine=n1.toLocaleString('es')+'€+'+n2.toLocaleString('es')+'€='+tot.toLocaleString('es')+'€';}
  const deudas=getDeudas();
  let deuLine='0';
  if(deudas.length===1){const d=deudas[0];deuLine=d.tipo+' '+d.cuota.toLocaleString('es')+'€'+(d.nota?' ('+d.nota+')':'');}
  else if(deudas.length>1){const tot=deudas.reduce((s,d)=>s+d.cuota,0);deuLine=deudas.map(d=>d.cuota.toLocaleString('es')+'€'+(d.nota?' ('+d.nota+')':'')).join('+')+' = '+tot.toLocaleString('es')+'€';}
  const rM=v('ratioMensual'),rK=v('ratioMaxK'),rA=v('ratioAnos');
  let ratioLine='';if(rM)ratioLine+=rM+'€';if(rK)ratioLine+=' / '+rK+'k';if(rA)ratioLine+=' a '+rA+' años';

  document.getElementById('pp_ing').textContent=ingLine;
  document.getElementById('pp_deu').textContent=deuLine;
  document.getElementById('pp_ent').textContent=(v('entrada')||'0')+'k';
  document.getElementById('pp_presu').textContent=presuMes?presuMes+'€/mes':'—';
  document.getElementById('pp_rat').textContent=ratioLine||'—';

  // Resultado
  const idealBox=document.getElementById('pp_idealBox');
  const idealLbl=document.getElementById('pp_idealLbl');
  if(mode==='precio'&&llega==='si'){
    idealBox.classList.add('llega');
    idealLbl.textContent='👌 LLEGA BIEN';idealLbl.className='res-lbl llega';
  } else {
    idealBox.classList.remove('llega');
    idealLbl.textContent='👌 PRECIO IDEAL';idealLbl.className='res-lbl ideal';
  }
  document.getElementById('pp_idealK').textContent=ik?ik+'k':'—';
  let idealSub='';
  if(mode==='presupuesto')idealSub='Presup. '+(presuMes||'—')+'€ · Hip. '+ih+'% · Aport. '+ia+'k';
  else if(llega==='si')idealSub='Hip. '+ih+'% · Aport. '+ia+'k';
  else idealSub='Presup. '+(presuMes||'—')+'€ · Hip. '+ih+'% · Aport. '+ia+'k';
  document.getElementById('pp_idealSub').textContent=idealSub;
  document.getElementById('pp_maxK').textContent=mk?mk+'k':'—';
  document.getElementById('pp_maxSub').textContent='Hip. '+mh+'% · Aport. '+ma+'k';

  // Notas
  const notas=[v('notaTitulares'),v('notaFinanzas'),v('notaResultado')].filter(Boolean);
  const notasEl=document.getElementById('pp_notas');
  notasEl.innerHTML=notas.length
    ?notas.map(n=>'<div class="nota-r">💡 '+n+'</div>').join('')
    :'<div class="nota-r" style="color:#b0bcd4;font-style:italic">Sin notas</div>';

  document.getElementById('printOverlay').classList.add('visible');
}

function closePrint() {
  document.getElementById('printOverlay').classList.remove('visible');
}

function imprimirVentana() {
  const content = document.getElementById('printPage').innerHTML;
  const fonts = `<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800;900&family=DM+Sans:wght@300;400;500&family=DM+Mono&display=swap" rel="stylesheet">`;
  const styles = Array.from(document.querySelectorAll('style')).map(s => '<style>'+s.innerHTML+'</style>').join('');
  const win = window.open('', '_blank', 'width=1200,height=800');
  win.document.write(`<!DOCTYPE html><html><head><meta charset="UTF-8">${fonts}${styles}<style>
    *{box-sizing:border-box;}
    html,body{width:297mm;height:210mm;overflow:hidden;margin:0;padding:0;background:white;}
    .print-page{width:297mm;height:210mm;overflow:hidden;display:flex;flex-direction:column;box-shadow:none;}
    .pb{flex:1;min-height:0;overflow:hidden;}
    .pt-cols{overflow:hidden;}
    @page{size:A4 landscape;margin:0;}
    .print-overlay,.print-toolbar,.header,.page{display:none!important;}
  </style></head><body><div class="print-page">${content}</div><script>window.onload=function(){window.focus();setTimeout(function(){window.print();},300);}<\/script></body></html>`);
  win.document.close();
}

const TEMPLATE_B64 = ""; // loaded separately

function abrirExcel() {
  const btn = document.getElementById('btnExcel');
  btn.textContent = 'Generando...';
  btn.disabled = true;

  const i1=parseFloat(v('ing1'))||0, p1=parseInt(v('pagas1'))||12, n1=Math.round(i1*p1/12);
  const i2=parseFloat(v('ing2'))||0, p2=parseInt(v('pagas2'))||12, n2=numTitulares===2?Math.round(i2*p2/12):0;
  const deudas=getDeudas();
  const totalDeudas=deudas.reduce((s,d)=>s+d.cuota,0);
  const edad1=parseInt(v('edad1'))||0;
  const edad2=numTitulares===2?parseInt(v('edad2'))||0:0;
  const edadMax=Math.max(edad1,edad2);
  const precioVivienda=mode==='precio'?(parseFloat(v('precioVivienda'))||0)*1000:0;
  const entradaEuros=(parseFloat(v('entrada'))||0)*1000;

  const payload = {
    nombre: v('nombre'),
    edad: edadMax,
    totalIngresos: n1+n2,
    totalDeudas: totalDeudas,
    presupuesto: parseFloat(v('presuMes'))||0,
    precioVivienda: precioVivienda,
    entrada: entradaEuros
  };

  fetch('/api/excel', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(payload)
  })
  .then(res => {
    if (!res.ok) throw new Error('Error generando Excel');
    return res.blob();
  })
  .then(blob => {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'Zen_' + (v('nombre')||'Asesoramiento') + '.xlsx';
    a.click();
    URL.revokeObjectURL(url);
    btn.textContent = '📊 Abrir en Excel';
    btn.disabled = false;
  })
  .catch(err => {
    alert('Error: ' + err.message);
    btn.textContent = '📊 Abrir en Excel';
    btn.disabled = false;
  });
}

</script>
</body>
</html>
